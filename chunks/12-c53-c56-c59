<script>(function(){
 var N=252,ad=[0],ix=[100];
 for(var i=1;i<N;i++){
  var net=Math.round(Math.sin(i/9)*120+Math.sin(i/31)*180+Math.sin(i/2.4)*60+22);
  if(i>190&&i<215)net-=90;
  ad.push(ad[i-1]+net);
  ix.push(ix[i-1]*(1+ (net/26000) + Math.sin(i/7)*0.0024 + 0.0004));}
 var W=940,H=260,L=52,R=54,T=14,B=24;
 var amn=Math.min.apply(null,ad),amx=Math.max.apply(null,ad);
 var imn=Math.min.apply(null,ix),imx=Math.max.apply(null,ix);
 var X=function(i){return L+i*(W-L-R)/(N-1)};
 var YA=function(v){return T+(amx-v)/(amx-amn)*(H-T-B)},YI=function(v){return T+(imx-v)/(imx-imn)*(H-T-B)};
 function draw(ov){
  var s="";
  for(var g=0;g<=4;g++){var y=T+g*(H-T-B)/4;
   s+='<line x1="'+L+'" y1="'+y+'" x2="'+(W-R)+'" y2="'+y+'" stroke="#f0f2f5"/>'+
   '<text x="'+(L-8)+'" y="'+(y+3)+'" text-anchor="end" font-size="9.5" font-family="ui-monospace" fill="#98a0b3">'+Math.round(amx-(amx-amn)*g/4).toLocaleString()+'</text>';}
  if(ov){
   s+='<rect x="'+X(190)+'" y="'+T+'" width="'+(X(215)-X(190))+'" height="'+(H-T-B)+'" fill="#e0483d" opacity=".06"/>';
   s+='<text x="'+(X(190)+6)+'" y="'+(T+12)+'" font-size="9" font-family="ui-monospace" fill="#c0392b">breadth lagged price</text>';
   var pi="";ix.forEach(function(v,i){pi+=(i?"L":"M")+X(i).toFixed(1)+","+YI(v).toFixed(1);});
   s+='<path d="'+pi+'" fill="none" stroke="#c0c6d2" stroke-width="1.6"/>'+
    '<text x="'+(W-R+6)+'" y="'+(YI(ix[N-1])+4)+'" font-size="10" font-family="ui-monospace" fill="#98a0b3">NYSE comp</text>';}
  var pa="";ad.forEach(function(v,i){pa+=(i?"L":"M")+X(i).toFixed(1)+","+YA(v).toFixed(1);});
  s+='<path d="'+pa+'L'+X(N-1)+','+(H-B)+'L'+L+','+(H-B)+'Z" fill="#3b62f6" opacity=".07"/>';
  s+='<path d="'+pa+'" fill="none" stroke="#3b62f6" stroke-width="2.2"/>';
  s+='<circle cx="'+X(N-1)+'" cy="'+YA(ad[N-1])+'" r="4" fill="#3b62f6"/>';
  ["May","Jul","Sep","Nov","Jan","Mar"].forEach(function(m,i){
   s+='<text x="'+X(i*42+8)+'" y="'+(H-6)+'" font-size="9.5" font-family="ui-monospace" fill="#98a0b3">'+m+'</text>';});
  document.getElementById("d56a-svg").innerHTML=s;
 }
 document.getElementById("d56a-ov").addEventListener("change",function(){draw(this.checked)});
 draw(true);
})();</script>
