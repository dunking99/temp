<script>(function(){
 var ALL=[];
 for(var i=0;i<252;i++){
  var net=Math.round(Math.sin(i/8)*140+Math.sin(i/29)*150+Math.sin(i/2.1)*70+18);
  ALL.push(net);}
 var n=120;
 function draw(hi){
  var d=ALL.slice(ALL.length-n),cum=[0];
  d.forEach(function(v,i){cum.push(cum[i]+v)});cum.shift();
  var W=940,H=300,L=48,R=52,T=12,B=90;
  var cmn=Math.min.apply(null,cum),cmx=Math.max.apply(null,cum);
  var X=function(i){return L+i*(W-L-R)/(d.length-1)};
  var YC=function(v){return T+(cmx-v)/(cmx-cmn||1)*(H-T-B-12)};
  var mxb=Math.max.apply(null,d.map(Math.abs));
  var YB=function(v){return (H-B/2)-(v/mxb)*(B/2-8)};
  var s="";
  for(var g=0;g<=3;g++){var y=T+g*(H-T-B-12)/3;
   s+='<line x1="'+L+'" y1="'+y+'" x2="'+(W-R)+'" y2="'+y+'" stroke="#171d26"/>'+
   '<text x="'+(L-8)+'" y="'+(y+3)+'" text-anchor="end" font-size="9" font-family="ui-monospace" fill="#59627a">'+Math.round(cmx-(cmx-cmn)*g/3).toLocaleString()+'</text>';}
  var pc="";cum.forEach(function(v,i){pc+=(i?"L":"M")+X(i).toFixed(1)+","+YC(v).toFixed(1);});
  s+='<path d="'+pc+'" fill="none" stroke="#5b8cff" stroke-width="2"/>';
  s+='<line x1="'+L+'" y1="'+(H-B/2)+'" x2="'+(W-R)+'" y2="'+(H-B/2)+'" stroke="#2a3140"/>';
  var bw=Math.max(1.4,(W-L-R)/d.length*0.62);
  d.forEach(function(v,i){
   s+='<rect class="colh" data-i="'+i+'" x="'+(X(i)-bw/2)+'" y="'+Math.min(YB(v),H-B/2)+'" width="'+bw+'" height="'+Math.abs(YB(v)-(H-B/2))+'" fill="'+(v>=0?"#18c281":"#ff5b52")+'" opacity="'+(hi===i?1:.7)+'"/>';});
  s+='<text x="'+(L-8)+'" y="'+(H-B/2+3)+'" text-anchor="end" font-size="9" font-family="ui-monospace" fill="#59627a">0</text>';
  s+='<text x="'+(W-R+6)+'" y="'+(YC(cum[cum.length-1])+4)+'" font-size="10" font-family="ui-monospace" fill="#5b8cff">A/D line</text>';
  s+='<text x="'+(W-R+6)+'" y="'+(H-B/2+3)+'" font-size="9.5" font-family="ui-monospace" fill="#59627a">daily net</text>';
  document.getElementById("d56b-svg").innerHTML=s;
  var last=d[d.length-1],idx=hi===undefined?d.length-1:hi;
  document.getElementById("d56b-rd").innerHTML=
   '<span>SESSION<b>'+(idx===d.length-1?"today":"t−"+(d.length-1-idx))+'</b></span>'+
   '<span>NET ADVANCES<b style="color:'+(d[idx]>=0?"#18c281":"#ff5b52")+'">'+(d[idx]>=0?"+":"")+d[idx]+'</b></span>'+
   '<span>CUMULATIVE<b>'+cum[idx].toLocaleString()+'</b></span>'+
   '<span>UP DAYS IN WINDOW<b>'+d.filter(function(v){return v>0}).length+' / '+d.length+'</b></span>'+
   '<span>10-DAY AVG<b>'+Math.round(d.slice(-10).reduce(function(a,b){return a+b},0)/10)+'</b></span>';
  [].forEach.call(document.querySelectorAll("#d56b .colh"),function(r){
   r.addEventListener("mouseenter",function(){draw(+r.dataset.i)});});
 }
 document.getElementById("d56b-zm").addEventListener("click",function(e){
  var b=e.target.closest("button");if(!b)return;
  [].forEach.call(this.children,function(x){x.classList.toggle("on",x===b)});n=+b.dataset.n;draw();});
 draw();
})();</script>
  </div>
</div>

